# epicmorg/mariadb: base configuration (works for every line 5.5 .. 13.x).
# Put your own settings into /etc/mysql/conf.d/*.cnf (read after this file).
[mysqld]
basedir = @BASEDIR@
datadir = /var/lib/mysql
socket = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid
secure-file-priv = /var/lib/mysql-files
skip-host-cache
skip-name-resolve

[client]
socket = /var/run/mysqld/mysqld.sock

!includedir /etc/mysql/conf.d/
