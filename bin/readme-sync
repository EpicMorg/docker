#!/usr/bin/env python3
"""Keep image READMEs in sync with the tree.

One Docker Hub / Quay / GHCR repository (`epicmorg/<name>`) = one *root* README:
the README.md in the common parent directory of every leaf that builds that
repository (a leaf = a directory with Dockerfile + docker-compose.yml). That
file is the repository description on the registries
(.github/workflows/docs.registry-descriptions.yml).

  * root README: prose is hand-written; the tag table between
        <!-- readme-sync:tags:begin --> ... <!-- readme-sync:tags:end -->
    is regenerated from the compose files. A root README that does not exist
    yet is created from a stub (title + tag table) - fill in the prose.
    The registry short description is taken from
        <!-- hub-description: one line, max 100 chars -->
  * leaf README: a short generated page (tag, base, link to the root README).
    It is (re)written only when it is missing, generated by this script
    (has the marker below) or known junk (copies of upstream READMEs that do
    not describe our image). Hand-written leaf READMEs are left alone.

Atlassian images are owned by bin/ansible and skipped; games are parked.

Usage: bin/readme-sync [--check] [--map] [--list-kept]
  --check      exit 1 if anything would change
  --map        print "repo<TAB>root README<TAB>short description" and exit
  --list-kept  print hand-written leaf READMEs that were left alone
"""
import os
import re
import sys
from collections import defaultdict

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TREES = ['linux/ecosystem', 'linux/advanced', 'linux/experimental']
SKIP = re.compile(r'/(atlassian|games|mattermost)(/|$)')   # mattermost: owner-maintained, out of scope
NAMESPACE = 'epicmorg/'
GEN = '<!-- generated by bin/readme-sync: edit the root README instead, this file is rewritten -->'
BEGIN, END = '<!-- readme-sync:tags:begin -->', '<!-- readme-sync:tags:end -->'
SHORT = re.compile(r'<!--\s*hub-description:\s*(.*?)\s*-->')
# leaf READMEs that are copies of somebody else's documentation
JUNK = ('TeamCity Minimal Build Agent', 'jetbrains/teamcity-minimal-agent',
        'IT IS AUTO-GENERATED', '# What is Nextcloud?', '# What is Zabbix?',
        'image: epicmorg/balancer')
GH = 'https://github.com/EpicMorg/docker'
MAX_ROWS = 60   # bigger repos get one row per group (parent dir) to stay under Docker Hub's 25 kB


def vkey(s):
    return [(0, int(p)) if p.isdigit() else (1, p) for p in re.split(r'(\d+)', s)]


def leaves():
    """{repo: [(leaf dir, [tags], [FROM refs])]}"""
    out = defaultdict(list)
    for tree in TREES:
        for d, dirs, files in os.walk(os.path.join(ROOT, tree)):
            dirs.sort()
            rel = os.path.relpath(d, ROOT)
            if SKIP.search('/' + rel) or 'Dockerfile' not in files or 'docker-compose.yml' not in files:
                continue
            compose = open(os.path.join(d, 'docker-compose.yml')).read()
            images = re.findall(r'^\s*image:\s*"?([^"\s]+?)"?\s*$', compose, re.M)
            froms = [f for f in re.findall(r'^FROM\s+(\S+)', open(os.path.join(d, 'Dockerfile')).read(), re.M)]
            per = defaultdict(list)
            # tags from `image:` first, then aliases that only exist in x-mirrors
            mirrors = [re.sub(r'^[a-z0-9.-]+\.[a-z]+/', '', m)
                       for m in re.findall(r'^\s*-\s*"?([^"\s]+)"?\s*$', compose, re.M)]
            for img in images + mirrors:
                if not img.startswith(NAMESPACE):
                    continue
                repo, _, tag = img.partition(':')
                tag = tag or 'latest'
                if tag not in per[repo]:
                    per[repo].append(tag)
            for repo, tags in per.items():
                out[repo].append((rel, tags, froms))
    return out


def root_of(items):
    return os.path.commonpath([d for d, _, _ in items])


def tag_table(repo, root, items):
    rows = []
    items = sorted(items, key=lambda x: vkey(x[0]))
    if len(items) <= MAX_ROWS:
        rows.append('| Tags | Dockerfile |')
        rows.append('| ---- | ---------- |')
        for d, tags, _ in items:
            link = os.path.relpath(d, root)
            rows.append('| %s | [`%s`](%s/Dockerfile) |' % (', '.join('`%s`' % t for t in tags),
                                                            link if link != '.' else '.', link))
    else:
        groups = defaultdict(list)
        for d, tags, _ in items:
            groups[os.path.dirname(os.path.relpath(d, root)) or '.'].extend(tags)
        rows.append('| Directory | Tags |')
        rows.append('| --------- | ---- |')
        for g in sorted(groups, key=vkey):
            rows.append('| [`%s`](%s) | %s |' % (g, g, ', '.join('`%s`' % t for t in sorted(groups[g], key=vkey))))
    rows.append('')
    rows.append('Every tag is pushed to `docker.io`, `quay.io` and `ghcr.io` (`%s:<tag>` on each) - '
                'same digest everywhere.' % repo)
    return '\n'.join([BEGIN, ''] + rows + ['', END])


def stub(repo, table):
    name = repo.split('/', 1)[1]
    return '\n'.join([
        '<!-- hub-description: EpicMorg %s image -->' % name,
        '# `%s`' % repo, '',
        'TODO: what this image is and what is inside.', '',
        '## Tags', '', table, '',
        '## Usage', '', 'TODO', '',
        footer(), ''])


def footer():
    return '\n'.join([
        '## Links', '',
        '* Source: [EpicMorg/docker](%s) - issues and PRs welcome' % GH,
        '* Tags float and are rebuilt weekly; pin by digest for reproducible builds: '
        '[Tags, pinning and updates](%s#tags-pinning-and-updates)' % GH,
        '* [CHANGELOG](%s/blob/master/CHANGELOG.md) - License: MIT' % GH])


def leaf_readme(repo, root, d, tags, froms):
    up = os.path.relpath(os.path.join(root, 'README.md'), d)
    base = [f for f in froms if not f.startswith('$')]
    lines = [GEN, '', '# `%s:%s`' % (repo, tags[0]), '']
    if len(tags) > 1:
        lines += ['Also tagged: ' + ', '.join('`%s`' % t for t in tags[1:]), '']
    if base:
        lines += ['Built from: ' + ', '.join('`%s`' % f for f in base), '']
    lines += ['Usage, tags and notes: [`%s`](%s).' % (repo, up), '']
    return '\n'.join(lines)


def main():
    check, changed, kept = '--check' in sys.argv, [], []
    data = leaves()
    if '--map' in sys.argv:
        for repo in sorted(data):
            rd = os.path.join(root_of(data[repo]), 'README.md')
            short = ''
            if os.path.exists(os.path.join(ROOT, rd)):
                m = SHORT.search(open(os.path.join(ROOT, rd)).read())
                short = m.group(1) if m else ''
            print('%s\t%s\t%s' % (repo, rd, short))
        return
    roots = defaultdict(list)          # root README -> repos sharing it (zabbix-*)
    for repo, items in data.items():
        roots[root_of(items)].append(repo)

    def write(path, text):
        full = os.path.join(ROOT, path)
        if os.path.exists(full) and open(full).read() == text:
            return
        changed.append(path)
        if not check:
            open(full, 'w').write(text)

    for root, repos in roots.items():
        path = os.path.join(root, 'README.md')
        tables = '\n\n'.join(
            (('### `%s`\n\n' % r) if len(repos) > 1 else '') + tag_table(r, root, data[r]).replace(BEGIN + '\n', '').replace('\n' + END, '')
            for r in sorted(repos))
        block = '%s\n%s\n%s' % (BEGIN, tables.strip('\n'), END)
        full = os.path.join(ROOT, path)
        text = open(full).read() if os.path.exists(full) else ''
        if BEGIN in text and END in text:
            new = text.split(BEGIN)[0] + block + text.split(END, 1)[1]
        elif not text or any(j in text for j in JUNK) or GEN in text:
            new = stub(sorted(repos)[0], block)
        else:   # hand-written root README without markers: append the table
            new = text.rstrip('\n') + '\n\n## Tags\n\n' + block + '\n'
        write(path, new)
        for repo in repos:
            for d, tags, froms in data[repo]:
                if d == root:
                    continue
                lp = os.path.join(d, 'README.md')
                lf = os.path.join(ROOT, lp)
                cur = open(lf, errors='ignore').read() if os.path.exists(lf) else ''
                if cur and GEN not in cur and not any(j in cur for j in JUNK):
                    kept.append(lp)
                    continue
                write(lp, leaf_readme(repo, root, d, tags, froms))
    if '--list-kept' in sys.argv:
        print('\n'.join(sorted(set(kept))))
    print('%d file(s) %s' % (len(changed), 'would change' if check else 'written'), file=sys.stderr)
    sys.exit(1 if check and changed else 0)


if __name__ == '__main__':
    main()
