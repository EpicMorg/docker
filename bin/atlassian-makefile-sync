#!/usr/bin/env python3
"""Regenerate the Atlassian targets of the root Makefile from the tree.

For every product under linux/ecosystem/apps/atlassian it writes
  ecosystem-<product>-<major>-images   (every version dir of that major)
  bundle-<product>                     (every major of the product)
and bundle-atlassian (every product bundle).

Everything lives between the markers below; the first run removes the old
hand-maintained blocks of the same names and puts the generated region where
the first of them was. Hand-curated targets (e.g. ecosystem-jira-8-lts-images)
and bundle-atlassian-latest are left alone.

Usage: bin/atlassian-makefile-sync [--check]
"""
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MAKEFILE = os.path.join(ROOT, 'Makefile')
ATL = 'linux/ecosystem/apps/atlassian'
BEGIN = '# >>> atlassian targets (generated by bin/atlassian-makefile-sync, do not edit)'
END = '# <<< atlassian targets'

# crucible/fisheye 2+ are symlinks to fisheye-crucible
CLEAN_EVERY = 10
PRODUCTS = ['jira', 'confluence', 'bitbucket', 'crowd', 'fisheye', 'crucible', 'fisheye-crucible']


def vkey(v):
    return [(int(n), s) for n, s in re.findall(r'(\d+)([a-z]*)', v)] or [(0, v)]


def leaves(product):
    """{major: [version, ...]} for real (non-symlink) dirs holding a Dockerfile."""
    out = {}
    base = os.path.join(ROOT, ATL, product)
    for major in os.listdir(base):
        mdir = os.path.join(base, major)
        if major == 'latest' or os.path.islink(mdir) or not os.path.isdir(mdir):
            continue
        vers = [v for v in os.listdir(mdir)
                if os.path.isfile(os.path.join(mdir, v, 'Dockerfile'))]
        if vers:
            out[major] = sorted(vers, key=vkey)
    return out


def generate():
    lines = [BEGIN, '']
    bundles = []
    for product in PRODUCTS:
        majors = leaves(product)
        if not majors:
            continue
        order = sorted(majors, key=vkey)
        for major in order:
            lines.append(f'ecosystem-{product}-{major}-images:')
            for i, v in enumerate(majors[major], 1):
                path = f'{ATL}/{product}/{major}/{v}'
                lines.append(f'\tcd `pwd`/{path:<60} && pwd && make build && make deploy')
                # free the builder's disk every CLEAN_EVERY images and at the end of a major
                if i % CLEAN_EVERY == 0 or i == len(majors[major]):
                    lines.append('\t@make clean')
            lines.append('')
        title = f'===== Building  All {product}  images ====='
        lines += [f'bundle-{product}:', f'\t@echo "{"=" * len(title)}"', f'\t@echo "{title}"',
                  f'\t@echo "{"=" * len(title)}"']
        lines += [f'\tmake ecosystem-{product}-{m}-images' for m in order]
        lines.append('')
        bundles.append(product)
    title = '===== Building  Atlassian  images ====='
    lines += ['bundle-atlassian:', f'\t@echo "{"=" * len(title)}"', f'\t@echo "{title}"',
              f'\t@echo "{"=" * len(title)}"']
    lines += [f'\tmake bundle-{p}' for p in bundles]
    lines += ['', END]
    return '\n'.join(lines) + '\n'


def strip_old(text):
    """Remove hand-maintained blocks the generator now owns; return text and insert offset."""
    owned = re.compile(r'^(ecosystem-(%s)-\d+-images|bundle-(%s)|bundle-atlassian):\s*$'
                       % ('|'.join(map(re.escape, PRODUCTS)), '|'.join(map(re.escape, PRODUCTS))))
    out, insert_at, skipping = [], None, False
    for line in text.splitlines(keepends=True):
        if owned.match(line):
            skipping = True
            if insert_at is None:
                insert_at = sum(len(l) for l in out)
            continue
        if skipping:
            if line.startswith('\t') or line.startswith('#\t') or line.strip() == '':
                continue
            skipping = False
        out.append(line)
    return ''.join(out), insert_at


def main():
    text = open(MAKEFILE).read()
    region = generate()
    if BEGIN in text:
        pre, rest = text.split(BEGIN, 1)
        post = rest.split(END, 1)[1].lstrip('\n')
        new = pre + region + '\n' + post
    else:
        body, at = strip_old(text)
        at = len(body) if at is None else at
        new = body[:at] + region + '\n' + body[at:]
    if '--check' in sys.argv:
        sys.exit(0 if new == text else 1)
    if new != text:
        open(MAKEFILE, 'w').write(new)
        print('Makefile: atlassian targets regenerated')
    else:
        print('Makefile: atlassian targets up to date')


if __name__ == '__main__':
    main()
