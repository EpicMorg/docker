services:
  app:
    image: "epicmorg/confluence:{{ tag | default(item) }}"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/confluence:{{ tag | default(item) }}
      - quay.io/epicmorg/confluence:{{ tag | default(item) }}
      - ghcr.io/epicmorg/confluence:{{ tag | default(item) }}
  app-jdk17:
    image: "epicmorg/confluence:{{ tag | default(item) }}-jdk17"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/confluence:{{ tag | default(item) }}-jdk17
      - quay.io/epicmorg/confluence:{{ tag | default(item) }}-jdk17
      - ghcr.io/epicmorg/confluence:{{ tag | default(item) }}-jdk17
  app-jdk21:
    image: "epicmorg/confluence:{{ tag | default(item) }}-jdk21"
    build:
      context: .
      dockerfile: Dockerfile.jdk21
    x-mirrors:
      - docker.io/epicmorg/confluence:{{ tag | default(item) }}-jdk21
      - quay.io/epicmorg/confluence:{{ tag | default(item) }}-jdk21
      - ghcr.io/epicmorg/confluence:{{ tag | default(item) }}-jdk21
