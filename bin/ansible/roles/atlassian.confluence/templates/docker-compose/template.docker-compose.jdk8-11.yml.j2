services:
  app:
    image: "epicmorg/confluence:{{ item }}"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/confluence:{{ item }}
  app-jdk8:
    image: "epicmorg/confluence:{{ item }}-jdk8"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/confluence:{{ item }}-jdk8
  app-jdk11:
    image: "epicmorg/confluence:{{ item }}-jdk11"
    build:
      context: .
      dockerfile: Dockerfile.jdk11
    x-mirrors:
      - quay.io/epicmorg/confluence:{{ item }}-jdk11
