services:
  app:
    image: "epicmorg/confluence:{{ item }}"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/confluence:{{ item }}
  app-jdk11:
    image: "epicmorg/confluence:{{ item }}-jdk11"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/confluence:{{ item }}-jdk11
  app-jdk17:
    image: "epicmorg/confluence:{{ item }}-jdk17"
    build:
      context: .
      dockerfile: Dockerfile.jdk17
    x-mirrors:
      - quay.io/epicmorg/confluence:{{ item }}-jdk17
