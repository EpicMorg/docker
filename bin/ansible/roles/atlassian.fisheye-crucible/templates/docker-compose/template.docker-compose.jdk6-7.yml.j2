services:
  app:
    image: "epicmorg/fisheye-crucible:{{ tag | default(item) }}"
    build:
      context: .
      dockerfile: Dockerfile.jdk7
    x-mirrors:
      - docker.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}
      - quay.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}
      - ghcr.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}
  app-jdk6:
    image: "epicmorg/fisheye-crucible:{{ tag | default(item) }}-jdk6"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}-jdk6
      - quay.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}-jdk6
      - ghcr.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}-jdk6
  app-jdk7:
    image: "epicmorg/fisheye-crucible:{{ tag | default(item) }}-jdk7"
    build:
      context: .
      dockerfile: Dockerfile.jdk7
    x-mirrors:
      - docker.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}-jdk7
      - quay.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}-jdk7
      - ghcr.io/epicmorg/fisheye-crucible:{{ tag | default(item) }}-jdk7
