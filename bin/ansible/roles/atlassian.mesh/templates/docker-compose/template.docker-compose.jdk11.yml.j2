services:
  app:
    image: "epicmorg/bitbucket-mesh:{{ tag | default(item) }}"
    build:
      context: .
    x-squash: false
    x-mirrors:
      - docker.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}
      - docker.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk11
      - quay.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}
      - quay.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk11
      - ghcr.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}
      - ghcr.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk11
