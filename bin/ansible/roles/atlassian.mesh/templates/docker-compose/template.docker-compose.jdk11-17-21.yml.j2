services:
  app:
    image: "epicmorg/bitbucket-mesh:{{ tag | default(item) }}"
    build:
      context: .
    x-squash: false
    x-mirrors:
      - docker.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}
      - quay.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}
      - ghcr.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}
  app-jdk11:
    image: "epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk11"
    build:
      context: .
    x-squash: false
    x-mirrors:
      - docker.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk11
      - quay.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk11
      - ghcr.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk11
  app-jdk17:
    image: "epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk17"
    build:
      context: .
      dockerfile: Dockerfile.jdk17
    x-squash: false
    x-mirrors:
      - docker.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk17
      - quay.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk17
      - ghcr.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk17
  app-jdk21:
    image: "epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk21"
    build:
      context: .
      dockerfile: Dockerfile.jdk21
    x-squash: false
    x-mirrors:
      - docker.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk21
      - quay.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk21
      - ghcr.io/epicmorg/bitbucket-mesh:{{ tag | default(item) }}-jdk21
