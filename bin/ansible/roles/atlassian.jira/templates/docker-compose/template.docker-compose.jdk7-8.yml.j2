services:
  app:
    image: "epicmorg/jira:{{ tag | default(item) }}"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/jira:{{ tag | default(item) }}
      - quay.io/epicmorg/jira:{{ tag | default(item) }}
      - ghcr.io/epicmorg/jira:{{ tag | default(item) }}
  app-jdk7:
    image: "epicmorg/jira:{{ tag | default(item) }}-jdk7"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/jira:{{ tag | default(item) }}-jdk7
      - quay.io/epicmorg/jira:{{ tag | default(item) }}-jdk7
      - ghcr.io/epicmorg/jira:{{ tag | default(item) }}-jdk7
  app-jdk8:
    image: "epicmorg/jira:{{ tag | default(item) }}-jdk8"
    build:
      context: .
      dockerfile: Dockerfile.jdk8
    x-mirrors:
      - docker.io/epicmorg/jira:{{ tag | default(item) }}-jdk8
      - quay.io/epicmorg/jira:{{ tag | default(item) }}-jdk8
      - ghcr.io/epicmorg/jira:{{ tag | default(item) }}-jdk8
