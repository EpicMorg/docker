# default JDK (Dockerfile) = jdk21; the extra JDK is built from Dockerfile.jdk17
services:
  app:
    image: "epicmorg/bitbucket:{{ tag | default(item) }}"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/bitbucket:{{ tag | default(item) }}
      - quay.io/epicmorg/bitbucket:{{ tag | default(item) }}
      - ghcr.io/epicmorg/bitbucket:{{ tag | default(item) }}
  app-jdk17:
    image: "epicmorg/bitbucket:{{ tag | default(item) }}-jdk17"
    build:
      context: .
      dockerfile: Dockerfile.jdk17
    x-mirrors:
      - docker.io/epicmorg/bitbucket:{{ tag | default(item) }}-jdk17
      - quay.io/epicmorg/bitbucket:{{ tag | default(item) }}-jdk17
      - ghcr.io/epicmorg/bitbucket:{{ tag | default(item) }}-jdk17
  app-jdk21:
    image: "epicmorg/bitbucket:{{ tag | default(item) }}-jdk21"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/bitbucket:{{ tag | default(item) }}-jdk21
      - quay.io/epicmorg/bitbucket:{{ tag | default(item) }}-jdk21
      - ghcr.io/epicmorg/bitbucket:{{ tag | default(item) }}-jdk21
