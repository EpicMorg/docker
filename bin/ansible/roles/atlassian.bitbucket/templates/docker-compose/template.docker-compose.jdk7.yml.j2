services:
  app:
    image: "epicmorg/bitbucket:{{ item }}"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/bitbucket:{{ item }}
  app-jdk7:
    image: "epicmorg/bitbucket:{{ item }}-jdk7"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/bitbucket:{{ item }}-jdk7
