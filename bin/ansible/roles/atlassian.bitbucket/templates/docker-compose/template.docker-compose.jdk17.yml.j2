services:
  app:
    image: "epicmorg/bitbucket:{{ item }}"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/bitbucket:{{ item }}
  app-jdk17:
    image: "epicmorg/bitbucket:{{ item }}-jdk17"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/bitbucket:{{ item }}-jdk17
