services:
  app:
    image: "epicmorg/crowd:{{ tag | default(item) }}"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/crowd:{{ tag | default(item) }}
      - quay.io/epicmorg/crowd:{{ tag | default(item) }}
      - ghcr.io/epicmorg/crowd:{{ tag | default(item) }}
  app-jdk8:
    image: "epicmorg/crowd:{{ tag | default(item) }}-jdk8"
    build:
      context: .
    x-mirrors:
      - docker.io/epicmorg/crowd:{{ tag | default(item) }}-jdk8
      - quay.io/epicmorg/crowd:{{ tag | default(item) }}-jdk8
      - ghcr.io/epicmorg/crowd:{{ tag | default(item) }}-jdk8
  app-jdk11:
    image: "epicmorg/crowd:{{ tag | default(item) }}-jdk11"
    build:
      context: .
      dockerfile: Dockerfile.jdk11
    x-mirrors:
      - docker.io/epicmorg/crowd:{{ tag | default(item) }}-jdk11
      - quay.io/epicmorg/crowd:{{ tag | default(item) }}-jdk11
      - ghcr.io/epicmorg/crowd:{{ tag | default(item) }}-jdk11
