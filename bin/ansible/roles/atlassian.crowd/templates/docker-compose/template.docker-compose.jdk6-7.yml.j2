services:
  app:
    image: "epicmorg/crowd:{{ item }}"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/crowd:{{ item }}
  app-jdk6:
    image: "epicmorg/crowd:{{ item }}-jdk6"
    build:
      context: .
    x-mirrors:
      - quay.io/epicmorg/crowd:{{ item }}-jdk6
  app-jdk7:
    image: "epicmorg/crowd:{{ item }}-jdk7"
    build:
      context: .
      dockerfile: Dockerfile.jdk7
    x-mirrors:
      - quay.io/epicmorg/crowd:{{ item }}-jdk7
